<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.owlivion.mail</id>
  <name>Owlivion Mail</name>
  <summary>Privacy-first AI-powered email client</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="com.owlivion">
    <name>Owlivion</name>
  </developer>
  <description>
    <p>
      Owlivion Mail is a modern, privacy-focused desktop email client with AI-powered features.
      Built with security at its core, it provides phishing detection, tracking pixel blocking,
      and end-to-end encrypted local storage.
    </p>
    <p>Features:</p>
    <ul>
      <li>AI-powered phishing detection and email summarization</li>
      <li>Multi-provider AI support (Gemini, Claude, OpenAI, Ollama)</li>
      <li>Tracking pixel and link blocker (60+ marketing services)</li>
      <li>AES-256-GCM encrypted local storage</li>
      <li>Multi-account support with OAuth2 (Gmail, Outlook)</li>
      <li>Dark and light theme</li>
      <li>Full-text search</li>
      <li>Email templates and signatures</li>
      <li>Keyboard shortcuts</li>
      <li>Cross-device sync with E2E encryption</li>
    </ul>
  </description>

{
  "app-id": "com.owlivion.mail",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "owlivion-mail",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-config/com.owlivion.mail:create",
    "--filesystem=xdg-data/com.owlivion.mail:create",
    "--env=WEBKIT_DISABLE_COMPOSITING_MODE=1"
  ],
  "modules": [
    {
      "name": "owlivion-mail",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 owlivion-mail /app/bin/owlivion-mail",
        "install -Dm644 com.owlivion.mail.desktop /app/share/applications/com.owlivion.mail.desktop",
        "install -Dm644 com.owlivion.mail.metainfo.xml /app/share/metainfo/com.owlivion.mail.metainfo.xml",
        "install -Dm644 icons/32x32.png /app/share/icons/hicolor/32x32/apps/com.owlivion.mail.png",
        "install -Dm644 icons/128x128.png /app/share/icons/hicolor/128x128/apps/com.owlivion.mail.png",
        "install -Dm644 icons/256x256.png /app/share/icons/hicolor/256x256/apps/com.owlivion.mail.png",
        "install -Dm644 icons/icon.png /app/share/icons/hicolor/512x512/apps/com.owlivion.mail.png"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/owlivion-tech/owlivion-mail/releases/download/v1.2.0/Owlivion.Mail_1.2.0_amd64.AppImage",
          "sha256": "b0f69a213bad52964a095ff391d83d622ed9dda16e7aa0234f310dc044d1f512",
          "strip-components": 0
        }
      ]
    }
  ]
}
